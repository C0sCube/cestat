{
  base_url: "https://ibbi.gov.in",
  headers: {
    "User-Agent": "Mozilla/5.0",
  },
  selectors: {
    table: ".reporttable",
    row: "tr",
    link: "a",
  },
  regex: {
    pdf: "newwindow1\\('(.+?)'\\)",
  },

  sections: {
    supreme_court: {
      url: "/orders/supreme-court",
      type: "pagination",
      pages: 10,
      columns: ["board", "srno", "date", "case", "remark", "pdf_link"],
    },
    ibbi: {
      url: "/orders/ibbi",
      type: "type_page",
      param: "order",
      types: {
        "41": "FAA",
        "42": "DC",
        "43": "Board",
        "44": "Others",
      },
      pages: 3,
      columns: ["board", "type", "srno", "date", "case", "remark", "pdf_link"],
    },
    nclat: {
      url: "/orders/nclat",
      type: "pagination",
      pages: 10,
      columns: ["board", "srno", "date", "case", "remark", "pdf_link"],
    },
    nclt: {
      url: "/orders/nclt",
      type: "type_page",
      columns: ["board", "bench", "srno", "date", "case", "remark", "pdf_link"],
      param: "nclt",
      types: {
        "25": "Principal Bench, New Delhi",
        "26": "New Delhi Bench - II",
        "27": "New Delhi Bench - III",
        "28": "New Delhi Bench - IV",
        "45": "New Delhi Bench - V",
        "46": "New Delhi Bench - VI",
        "29": "Ahmedabad Bench",
        "30": "Allahabad Bench",
        "49": "Amravati Bench",
        "31": "Bengaluru Bench",
        "32": "Chandigarh Bench",
        "33": "Chennai Bench",
        "47": "Cuttack Bench",
        "34": "Guwahati Bench",
        "35": "Hyderabad Bench",
        "48": "Indore Bench",
        "36": "Jaipur Bench",
        "39": "Kochi Bench",
        "37": "Kolkata Bench",
        "38": "Mumbai Bench",
        "40": "Others",
      },
      pages: 4,
    },
