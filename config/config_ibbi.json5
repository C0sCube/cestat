{
  base_url: "https://ibbi.gov.in",
  headers: {
    "User-Agent": "Mozilla/5.0",
  },
  selectors: {
    table: ".reporttable",
    row: "tr",
    link: "a",
  },
  regex: {
    pdf: "newwindow1\\('(.+?)'\\)",
  },
  columns: ["section", "sr_no", "date", "title", "category", "pdf_link"],
  other_data: {
    ibbi: {
      "41": "FAA",
      "42": "DC",
      "43": "Board",
      "44": "Others",
    },
    nclt: {
      "25": "Principal Bench, New Delhi",
